<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.edusync.controllers.AdminDashboardController">
    
    <top>
        <HBox spacing="20.0" style="-fx-background-color: #333333;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <Label text="EduSync | Administrator Control Panel" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
        </HBox>
    </top>

    <left>
        <VBox spacing="10.0" style="-fx-background-color: #e0e0e0;" prefWidth="200.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>
            <Label fx:id="adminNameLabel" text="Welcome, Admin">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </Label>
            
            <Button text="View Course Catalog" prefWidth="180.0" onAction="#handleViewCourses"/>
            <Button text="Add New Course" prefWidth="180.0" />
            <Button text="Manage Faculty" prefWidth="180.0" />
            <Button text="System Analytics" prefWidth="180.0" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <Label text="Official Course Catalog">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            
            <TableView fx:id="courseTable" prefHeight="450.0" prefWidth="500.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colCode" prefWidth="100.0" text="Code" />
                <TableColumn fx:id="colName" prefWidth="200.0" text="Course Name" />
                <TableColumn fx:id="colCredits" prefWidth="75.0" text="Credits" />
                <TableColumn fx:id="colDept" prefWidth="125.0" text="Department" />
              </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>